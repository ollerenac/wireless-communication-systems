options:
  parameters:
    author: Wireless Comm Systems 2026
    catch_exceptions: 'True'
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ofdm_demo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: OFDM Demo Educativo
    window_size: (1400,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:

# ── Variables ────────────────────────────────────────────────────────────────

- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '100000'
  states:
    coordinate: [184, 12]
    rotation: 0
    state: enabled

- name: fft_size
  id: variable
  parameters:
    comment: ''
    value: '64'
  states:
    coordinate: [320, 12]
    rotation: 0
    state: enabled

- name: cp_len
  id: variable
  parameters:
    comment: ''
    value: '16'
  states:
    coordinate: [440, 12]
    rotation: 0
    state: enabled

- name: noise_amp
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Ruido sigma
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.0'
    step: '0.01'
    stop: '2.0'
    value: '0.1'
    widget: counter_slider
  states:
    coordinate: [560, 8]
    rotation: 0
    state: enabled

- name: qpsk_const
  id: variable
  parameters:
    comment: ''
    value: digital.constellation_qpsk().base()
  states:
    coordinate: [800, 12]
    rotation: 0
    state: enabled

# ── TX ───────────────────────────────────────────────────────────────────────

- name: analog_random_uniform_source_x_0
  id: analog_random_uniform_source_x
  parameters:
    comment: 'Fuente de bits {0,1}'
    maximum: '2'
    minimum: '0'
    seed: '0'
    type: byte
  states:
    coordinate: [48, 192]
    rotation: 0
    state: enabled

- name: blocks_throttle_0
  id: blocks_throttle
  parameters:
    comment: ''
    ignoretag: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: byte
    vlen: '1'
  states:
    coordinate: [224, 192]
    rotation: 0
    state: enabled

- name: blocks_pack_k_bits_bb_0
  id: blocks_pack_k_bits_bb
  parameters:
    comment: '2 bits -> simbolo {0,1,2,3}'
    k: '2'
  states:
    coordinate: [384, 192]
    rotation: 0
    state: enabled

- name: digital_chunks_to_symbols_xx_0
  id: digital_chunks_to_symbols_xx
  parameters:
    comment: 'Indice -> punto QPSK X[k]'
    D: '1'
    in_type: byte
    out_type: complex
    symbol_table: qpsk_const.points()
  states:
    coordinate: [544, 192]
    rotation: 0
    state: enabled

- name: blocks_stream_to_vector_0
  id: blocks_stream_to_vector
  parameters:
    comment: 'N simbolos -> vector OFDM'
    num_items: fft_size
    type: complex
    vlen: '1'
  states:
    coordinate: [736, 192]
    rotation: 0
    state: enabled

- name: fft_vxx_0
  id: fft_vxx
  parameters:
    comment: 'IFFT: X[k] -> x[n]'
    fft_size: fft_size
    forward: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    nthreads: '1'
    shift: 'False'
    type: complex
    window: '[]'
  states:
    coordinate: [896, 192]
    rotation: 0
    state: enabled

- name: digital_ofdm_cyclic_prefixer_0
  id: digital_ofdm_cyclic_prefixer
  parameters:
    comment: 'Copia ultimas CP_LEN muestras al inicio'
    input_size: fft_size
    output_size: fft_size+cp_len
    rolloff_len: '0'
    len_tag_key: '""'
  states:
    coordinate: [1072, 192]
    rotation: 0
    state: enabled

# ── Canal ────────────────────────────────────────────────────────────────────

- name: channels_channel_model_0
  id: channels_channel_model
  parameters:
    block_tags: 'False'
    comment: 'AWGN plano: taps=[1], sin multipath'
    epsilon: '1.0'
    freq_offset: '0.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_voltage: noise_amp
    seed: '0'
    taps: '[1.0+0j]'
  states:
    coordinate: [1072, 392]
    rotation: 0
    state: enabled

# ── RX ───────────────────────────────────────────────────────────────────────

- name: blocks_keep_m_in_n_0
  id: blocks_keep_m_in_n
  parameters:
    comment: 'Quitar CP: muestras [CP_LEN : CP_LEN+N]'
    m: fft_size
    maxoutbuf: '0'
    minoutbuf: '0'
    n: fft_size+cp_len
    offset: cp_len
    type: complex
  states:
    coordinate: [1072, 592]
    rotation: 0
    state: enabled

- name: blocks_stream_to_vector_1
  id: blocks_stream_to_vector
  parameters:
    comment: ''
    num_items: fft_size
    type: complex
    vlen: '1'
  states:
    coordinate: [896, 592]
    rotation: 0
    state: enabled

- name: fft_vxx_1
  id: fft_vxx
  parameters:
    comment: 'FFT: x[n] -> Y[k] = N*X[k]'
    fft_size: fft_size
    forward: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    nthreads: '1'
    shift: 'False'
    type: complex
    window: '[]'
  states:
    coordinate: [736, 592]
    rotation: 0
    state: enabled

- name: blocks_vector_to_stream_0
  id: blocks_vector_to_stream
  parameters:
    comment: ''
    num_items: fft_size
    type: complex
    vlen: '1'
  states:
    coordinate: [576, 592]
    rotation: 0
    state: enabled

- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    comment: 'Ecualizacion: dividir por N compensa ganancia IFFT->FFT'
    const: 1.0/fft_size
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    coordinate: [416, 592]
    rotation: 0
    state: enabled

- name: digital_constellation_decoder_cb_0
  id: digital_constellation_decoder_cb
  parameters:
    comment: 'Decision dura QPSK'
    constellation: qpsk_const
  states:
    coordinate: [256, 592]
    rotation: 0
    state: enabled

- name: blocks_unpack_k_bits_bb_0
  id: blocks_unpack_k_bits_bb
  parameters:
    comment: ''
    k: '2'
  states:
    coordinate: [112, 592]
    rotation: 0
    state: enabled

- name: blocks_null_sink_0
  id: blocks_null_sink
  parameters:
    bus_connectivity: '[]'
    comment: 'Aqui iria el comparador BER'
    num_inputs: '1'
    type: byte
    vlen: '1'
  states:
    coordinate: [48, 728]
    rotation: 0
    state: enabled

# ── GUI Sinks ─────────────────────────────────────────────────────────────────

- name: qtgui_const_sink_x_0
  id: qtgui_const_sink_x
  parameters:
    alpha1: '1.0'
    color1: '"blue"'
    comment: ''
    grid: 'False'
    gui_hint: ''
    label1: ''
    legend: 'True'
    name: '"TX: Constelacion QPSK"'
    nconnections: '1'
    size: '1024'
    style1: '0'
    update_time: '0.10'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    coordinate: [544, 320]
    rotation: 0
    state: enabled

- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters:
    alpha1: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: '"blue"'
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: Re
    label2: Im
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    legend: 'True'
    marker1: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    name: '"TX: Simbolo OFDM + CP (tiempo)"'
    nconnections: '1'
    size: fft_size+cp_len
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    ylabel: Amplitud
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    coordinate: [1240, 160]
    rotation: 0
    state: enabled

- name: qtgui_time_sink_x_1
  id: qtgui_time_sink_x
  parameters:
    alpha1: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: '"red"'
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: Re
    label2: Im
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    legend: 'True'
    marker1: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    name: '"RX: Senal recibida (tiempo)"'
    nconnections: '1'
    size: fft_size+cp_len
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    ylabel: Amplitud
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    coordinate: [1240, 360]
    rotation: 0
    state: enabled

- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    average: '1.0'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '1024'
    grid: 'False'
    gui_hint: ''
    label: '"Ganancia relativa"'
    label1: ''
    legend: 'True'
    name: '"RX: Espectro OFDM (subportadoras)"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    type: complex
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-140'
  states:
    coordinate: [1240, 500]
    rotation: 0
    state: enabled

- name: qtgui_const_sink_x_1
  id: qtgui_const_sink_x
  parameters:
    alpha1: '1.0'
    color1: '"green"'
    comment: ''
    grid: 'False'
    gui_hint: ''
    label1: ''
    legend: 'True'
    name: '"RX: Constelacion post-ecualizacion"'
    nconnections: '1'
    size: '1024'
    style1: '0'
    update_time: '0.10'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    coordinate: [416, 728]
    rotation: 0
    state: enabled

connections:
# TX
- [analog_random_uniform_source_x_0, '0', blocks_throttle_0, '0']
- [blocks_throttle_0, '0', blocks_pack_k_bits_bb_0, '0']
- [blocks_pack_k_bits_bb_0, '0', digital_chunks_to_symbols_xx_0, '0']
- [digital_chunks_to_symbols_xx_0, '0', qtgui_const_sink_x_0, '0']
- [digital_chunks_to_symbols_xx_0, '0', blocks_stream_to_vector_0, '0']
- [blocks_stream_to_vector_0, '0', fft_vxx_0, '0']
- [fft_vxx_0, '0', digital_ofdm_cyclic_prefixer_0, '0']
- [digital_ofdm_cyclic_prefixer_0, '0', qtgui_time_sink_x_0, '0']
- [digital_ofdm_cyclic_prefixer_0, '0', channels_channel_model_0, '0']
# Canal
- [channels_channel_model_0, '0', qtgui_time_sink_x_1, '0']
- [channels_channel_model_0, '0', qtgui_freq_sink_x_0, '0']
- [channels_channel_model_0, '0', blocks_keep_m_in_n_0, '0']
# RX
- [blocks_keep_m_in_n_0, '0', blocks_stream_to_vector_1, '0']
- [blocks_stream_to_vector_1, '0', fft_vxx_1, '0']
- [fft_vxx_1, '0', blocks_vector_to_stream_0, '0']
- [blocks_vector_to_stream_0, '0', blocks_multiply_const_vxx_0, '0']
- [blocks_multiply_const_vxx_0, '0', qtgui_const_sink_x_1, '0']
- [blocks_multiply_const_vxx_0, '0', digital_constellation_decoder_cb_0, '0']
- [digital_constellation_decoder_cb_0, '0', blocks_unpack_k_bits_bb_0, '0']
- [blocks_unpack_k_bits_bb_0, '0', blocks_null_sink_0, '0']
